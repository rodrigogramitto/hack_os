/**
 * This library provides two services: direct access to the computer's main
 * memory (RAM), and allocation and recycling of memory blocks. The Hack RAM
 * consists of 32,768 words, each holding a 16-bit binary number.
 */
class Memory {
    static Array RAM;
    static Array HEAP;
    static Array freeList;

    /** Initializes the class. */
    function void init() {
        let RAM = 0;
        let HEAP = 2048;
        let freeList = 2048;
        let freeList[0] = 0;
        let freeList[1] = 14334;
        return;
    }

    /** Returns the RAM value at the given address. */
    function int peek(int address) {
        return RAM[address];
    }

    /** Sets the RAM value at the given address to the given value. */
    function void poke(int address, int value) {
        let RAM[address] = value;
        return;
    }

    /** Finds an available RAM block of the given size and returns
     *  a reference to its base address. */
    function Array alloc(int size) {
        var Array prev, cur, block;

        if ( size < 0 ) {
            do Sys.error(5);
        }

        let cur = freeList;
        let prev = -1;
        while (~ (cur = 0) ) {
            // Case where block fits in segment and space is left over
            if ( (size + 2) < cur[1]) {
                let block = cur + (cur[1] - (size + 2));
                let cur[1] = cur[1] - (size + 2); // adjust size

                let block[1] = size;
                return block + 2;
            }

            // Case where block is exact size or left over size is less than two bits
            // We must point last pointer to next and return whole block
            if ( (size + 2) = cur[1] | (cur[1] - (size + 2) ) < 2 ) {
                let block = cur;
                if (prev = -1) {
                    let freeList = cur[0];
                } else {
                    let prev[0] = cur[0];
                }

                return block + 2;
            }

            let prev = cur;
            let cur  = cur[0];
        }

        do Sys.error(6);
        return 0;
    }

    /** De-allocates the given object (cast as an array) by making
     *  it available for future allocations. */
    function void deAlloc(Array o) {
        var Array cur, block;

        let block = o - 2; // Get base address
        let cur = freeList;
        while ( ~(cur[0] = 0) ) {
            let cur = cur[0];
        }

        let cur[0] = block;
        let block[0] = 0;

        return;
    }

    /** De-fragments the heap */
    function void deFrag() {
        var Array cur, next;
        let cur = freeList;
        while (~ (cur[0] = 0) ) {
            let next = cur[0];
            let cur[1] = cur[1] + next[1];
            let cur[0] = next[0];
        }
        return;
    }
}
